# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Local runs: Spring Boot reads ../.env from api/ (spring.config.import). Docker Compose reads it too.
DB_URL=jdbc:postgresql://localhost:5432/ainalyzing
DB_USER=ainalyzing
DB_PASSWORD=change-me

# Groq (llm package). Without a key the app still runs and answers with local templates (status fallback).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Deadline for one whole insight or chat turn, all Groq requests included.
GROQ_TIMEOUT_MS=5000
# Local guard for the shared free-tier key; beyond it answers use templates.
GROQ_MAX_CALLS_PER_MINUTE=20
# Demand sources whose aggregated facts may be sent to Groq (docs/decisions.md D-09).
GROQ_EGRESS_SOURCES=demo,manual,csv

# true behind HTTPS (VPS), false for http://localhost
COOKIE_SECURE=false
