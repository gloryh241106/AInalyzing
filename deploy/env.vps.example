# VPS settings. Copy to the repo root as .env, then: chmod 600 .env. Never commit .env.
# Comments stay on their own lines (no "value # comment").

# Domain whose DNS A record points at this VPS, e.g. demo.example.com or 203-0-113-10.sslip.io
DOMAIN=

# Generate once with: openssl rand -hex 24
# PostgreSQL only reads it when the db-data volume is first created.
DB_USER=ainalyzing
DB_PASSWORD=

# Groq key from console.groq.com. Leave empty to run with template answers only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=5000
GROQ_MAX_CALLS_PER_MINUTE=20
# Use "demo" to keep uploaded CSV facts on the VPS (docs/decisions.md D-09).
GROQ_EGRESS_SOURCES=demo,manual,csv

# The session cookie is only sent over HTTPS.
COOKIE_SECURE=true

# Tag for the built image, e.g. the short commit: git rev-parse --short HEAD
APP_VERSION=
